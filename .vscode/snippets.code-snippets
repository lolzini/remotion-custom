{
	"Remotion Video Composition": {
		"prefix": "video",
		"body": [
			"import {AbsoluteFill, Composition} from 'remotion';",
			"import {z} from 'zod';",
			"",
			"const FPS = 30;",
			"const DIF = FPS * 2;",
			"",
			"const schema = z.object({});",
			"",
			"export const Component = ({}: z.infer<typeof schema>) => {",
			"\treturn (",
			"\t\t<>",
			"\t\t\t<AbsoluteFill></AbsoluteFill>",
			"\t\t</>",
			"\t);",
			"};",
			"",
			"export default function () {",
			"\treturn (",
			"\t\t<Composition",
			"\t\t\tid=\"${1:composition-id}\"",
			"\t\t\tcomponent={Component}",
			"\t\t\twidth={1920}",
			"\t\t\theight={1080}",
			"\t\t\tfps={30}",
			"\t\t\tdurationInFrames={DIF}",
			"\t\t\tschema={schema}",
			"\t\t\tdefaultProps={{}}",
			"\t\t/>",
			"\t);",
			"}",
			"",
			"// HELPERS ------------",
		],
		"description": "Creates a basic Remotion video composition component with 1920x1080 resolution",
	},
	"Remotion Social Composition": {
		"prefix": "compo",
		"body": [
			"import {AbsoluteFill} from 'remotion';",
			"import {z} from 'zod';",
			"",
			"const width = 600;",
			"const height = 400;",
			"const fps = 60;",
			"const durationInFrames = fps * 60;",
			"",
			"const schema = z.object({});",
			"",
			"function ${1:Component}({}) {",
			"\treturn (",
			"\t\t<AbsoluteFill className=\"items-center justify-center\">",
			"\t\t\t{/* ${2:Content} */}",
			"\t\t</AbsoluteFill>",
			"\t);",
			"}",
			"",
			"export {${1:Component} as component, schema, fps, durationInFrames, width, height};",
		],
		"description": "Creates a basic Remotion social media composition component",
	},
}
